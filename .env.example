# Replace every digest with an operator-verified, published image digest.
GCAI_BACKEND_IMAGE=registry.example/gc-ai-backend@sha256:REPLACE
GCAI_FRONTEND_IMAGE=registry.example/gc-ai-frontend@sha256:REPLACE
GCAI_MYSQL_IMAGE=mysql:8.4@sha256:REPLACE
GCAI_TRUSTED_ORIGINS=https://gcai.example.org
GCAI_UID=10001
GCAI_GID=10001
# Verify numeric identities using id in the pinned images before deployment.
GCAI_MYSQL_UID=999
GCAI_MYSQL_GID=999
GCAI_NGINX_UID=101
GCAI_NGINX_GID=101

# Exact data identities from the reviewed release manifest; mandatory before preparation.
GCAI_EXPECTED_CHECKPOINT_SHA256=REPLACE_WITH_64_HEX
GCAI_EXPECTED_REGISTRY_SHA256=REPLACE_WITH_64_HEX
