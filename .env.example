# Copy to .env to override the defaults in docker-compose.yml.
# docker compose reads .env automatically; every value below is optional.

# Host port for the web interface.
FRONTEND_PORT=8081

# Host port for the backend API. The container port stays 5001 because the
# frontend bundle has http://localhost:5001 compiled in, so changing this
# breaks the web interface while leaving the API reachable on the new port.
BACKEND_PORT=5001

# Host port for MySQL.
DB_PORT=3307

# MySQL root password. Used by both the database and the backend; the bundled
# database image was built with this value, so changing it only works on a
# fresh volume (docker compose down -v).
DB_PASSWORD=igemparts2024
